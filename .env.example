# ══════════════════════════════════════════════════════════════════════════════
# open-autoDM - environment variables
#
# These are the ONLY secrets that live in the deployment environment.
# Your Meta App ID / App Secret are entered through the in-app Setup Wizard
# after you deploy - they are stored AES-256-GCM encrypted in your Supabase DB.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (from supabase.com → your project → Settings → API) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Encryption key - 64 hex chars (32 bytes). Generate once with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt Instagram tokens + your Meta App Secret before they touch the DB.
# If you lose or change this key, you must reconnect Instagram and re-run setup.
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Cron secret - any long random string. Generate with:
#    node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Protects the background job-processing endpoint (/api/cron/process-jobs).
CRON_SECRET=your_random_cron_secret_here

# ── Public URL of THIS deployment (no trailing slash) ────────────────────────
# e.g. https://my-autodm.vercel.app  or  https://open-autodm.me.workers.dev
NEXT_PUBLIC_APP_URL=https://your-deployment-url.example.com
