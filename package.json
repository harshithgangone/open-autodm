{
  "name": "open-autodm",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source, self-hosted Instagram comment-to-DM automation. One Next.js deployment + your own Supabase + your own Meta app.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/transport.integration.ts",
    "bot:example": "tsx scripts/echo-bot.ts",
    "migrate": "tsx --env-file=.env.local scripts/migrate.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.23.15",
    "undici": "^8.11.2",
    "zod": "^3.25.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.6.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.20.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
